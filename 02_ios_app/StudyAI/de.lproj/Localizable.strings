"helpCenter.faq5.answer" = "Your streak increases each day you complete at least one study session. Maintain your streak to unlock achievements and rewards\!";
"helpCenter.faq6.question" = "Is my data secure?";
"helpCenter.faq6.answer" = "Yes\! We use industry-standard encryption and secure authentication. Your homework and learning data are stored securely and never shared with third parties.";
"helpCenter.faq7.question" = "How do I track my progress?";
