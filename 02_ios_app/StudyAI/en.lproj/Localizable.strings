// Help Center
"helpCenter.subtitle" = "Find answers to common questions";
"helpCenter.faq1.question" = "How do I grade my homework?";
"helpCenter.faq1.answer" = "Open the Grader tab and tap the camera to take a photo, or choose from your photo library or Files app. The AI reads each question, grades your answers, and provides step-by-step solutions with explanations. You can archive individual questions to your Library for later review.";
"helpCenter.faq2.question" = "What subjects are supported?";
"helpCenter.faq2.answer" = "The Homework Grader supports Mathematics, Physics, Chemistry, Biology, English, History, Geography, and Computer Science. The AI chat assistant can also help with topics beyond these subjects.";
"helpCenter.faq3.question" = "How do I use Live Mode?";
"helpCenter.faq3.answer" = "Open the Chat tab, tap the menu icon at the top right, and select Live Talk. Live Mode lets you have a real-time spoken conversation with your AI tutor. It is available on Premium and Premium Plus plans.";
"helpCenter.faq4.question" = "How do I practice and review my mistakes?";
"helpCenter.faq4.answer" = "From the Home tab, tap Practice to generate custom questions by subject, difficulty, and type. Tap Mistake Review to see a breakdown of your weak areas — the app automatically tracks errors from every graded session and lets you generate targeted practice from them.";
"helpCenter.faq5.question" = "How does Focus Mode and the Tomato Garden work?";
"helpCenter.faq5.answer" = "Tap Focus Mode on the Home tab to start a 25-minute study session. Completing a session earns a collectible tomato. There are 13 tomato types across 4 rarity tiers. Collect 5 tomatoes of the same type to combine them into a rarer one. Your garden holds up to 25 tomatoes at a time.";
"helpCenter.faq6.question" = "Is my data secure?";
"helpCenter.faq6.answer" = "Yes. All communication is encrypted over HTTPS and your login credentials are stored securely in the device Keychain. Your data is processed by trusted AI providers solely to deliver tutoring features, and is never sold or used for advertising.";
"helpCenter.faq7.question" = "What subscription plans are available?";
"helpCenter.faq7.answer" = "StudyAgent offers four tiers: Guest (no sign-up, limited to 3 homework scans and 10 chat messages lifetime), Free (monthly limits on homework, chat, and practice), Premium (higher limits plus Live Mode and parent reports), and Premium Plus (unlimited everything). View your current usage in Settings > Account Usage.";
"helpCenter.faq8.question" = "What is the difference between Deep and Fast grading?";
"helpCenter.faq8.answer" = "Fast grading uses AI for quick scoring — great for everyday homework. Deep grading enables a more powerful reasoning model for complex problems (multi-step proofs, essays, derivations) with more detailed analysis, but takes longer. Toggle it in the top-right of the grading screen.";
"helpCenter.quickLinks" = "Quick Links";
